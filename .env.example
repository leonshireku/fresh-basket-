# ============================================================
# FreshBasket Database & Server Configuration Template
# ============================================================

# --- OPTION 1: TiDB Cloud Format (Recommended for TiDB) ---
TIDB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_prefix.root
TIDB_PASSWORD=your_tidb_password
TIDB_DATABASE=freshbasket

# --- OPTION 2: Standard DB_* Format ---
# DB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=your_prefix.root
# DB_PASSWORD=your_tidb_password
# DB_NAME=freshbasket

# --- OPTION 3: Full Connection URL ---
# DATABASE_URL=mysql://your_user:your_password@gateway01...:4000/freshbasket

# Local HTTP Server Port
PORT=3000
